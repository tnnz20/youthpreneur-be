# HTTP server listen address
APP_ADDR=:8080

# Log level: debug, info, warn, or error
APP_LOG_LEVEL=info

# Application environment: development, staging, or production
APP_ENV=development

# Application version
APP_VERSION=dev

# Graceful shutdown timeout for SIGINT/SIGTERM
APP_SHUTDOWN_TIMEOUT=10s

# JWT signing secret. Required in every environment and never committed.
# At least 32 bytes outside development. Generate one with:
#   openssl rand -base64 32
APP_AUTH_SECRET=

# Access token lifetime and refresh token lifetime
# Access token lifetime
APP_AUTH_ACCESS_TOKEN_TTL=15m

# Refresh token lifetime
APP_AUTH_REFRESH_TOKEN_TTL=168h

# Comma-separated browser origins allowed to call the API with credentials
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Per-client-IP request limits per minute
APP_RATE_LIMIT_LOGIN_PER_MINUTE=5
APP_RATE_LIMIT_REFRESH_PER_MINUTE=10
APP_RATE_LIMIT_GENERAL_PER_MINUTE=60

# PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=youthpreneur

# PostgreSQL SSL mode: disable, require, verify-ca, or verify-full
POSTGRES_SSLMODE=disable

# Initial admin account created by `make seed` (cmd/seeder). Both are required
# when seeding; set real values in the process environment, never commit them.
SEEDER_ADMIN_EMAIL=
SEEDER_ADMIN_PASSWORD=
